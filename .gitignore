
# ============================================================
# Datheon Machine Learning & Data Science Internship
# Git Ignore Configuration
# ============================================================

# Python Virtual Environments
.venv/
venv/
env/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook
.ipynb_checkpoints/
.jupyter/

# Environment Variables and Secrets
.env
.env.*
!.env.example
*.key
*.pem

# IDE and Editor Files
.vscode/
.idea/

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini

# Python Build and Distribution
build/
dist/
*.egg-info/
.eggs/

# Testing and Coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Temporary and Log Files
*.log
*.tmp
*.temp
*.bak

# ============================================================
